{
  "name": "@dune/theme-api",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "minimumDependencyAge": {
    "age": "P1D"
  },
  "tasks": {
    "test": "deno test --allow-read=src tests/",
    "check": "deno fmt --check && deno lint && deno check src/**/*.ts tests/**/*.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  }
}
